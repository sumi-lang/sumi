{
  "comments": {
    "lineComment": "//"
  },
  "brackets": [
    ["{", "}"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "(", "close": ")" }
  ],
  "surroundingPairs": [
    ["{", "}"],
    ["(", ")"]
  ],
  "indentationRules": {
    "increaseIndentPattern": "^.*[({]\\s*(?://.*)?$",
    "decreaseIndentPattern": "^\\s*[)}]"
  },
  "wordPattern": "[A-Za-z_][A-Za-z0-9_]*|[0-9]+"
}
