== fixed ==
// A glued `*` is reserved for a prefix operator, so every glued product
// stays an error, on one line and leading the next.
fn f() {
    let x = a * b
    let y = a * b
    let z = x
    * b
}

== normalized ==
// A glued `*` is reserved for a prefix operator, so every glued product
// stays an error, on one line and leading the next.
fn f() {
    let x = a * b
    let y = a * b
    let z = x
    * b
}
