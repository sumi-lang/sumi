== formatted ==
remaining: ChainedComparison, UnspacedBinaryOperator

// A `<` glued to the name before it opens type arguments only where a `>`
// and the `(` of a call close them, so every other glued comparison stays
// an error.
fn f() {
    if a < b {
        return 1
    }
    if a<b>c {
        return 2
    }
    if a < b && c > (d) {
        return 3
    }
    let x = a < b
    let y = a < b
}
