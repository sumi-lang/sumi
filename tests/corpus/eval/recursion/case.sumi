fn fib(n: int) -> int = if n < 2 { n } else { fib(n - 1) + fib(n - 2) }
fn fib_15() -> int = fib(15)
fn count(n: int) -> int = if n == 0 { 0 } else { 1 + count(n - 1) }
fn deep() -> int = count(10000)
fn dead_step(n: int) -> int = if n > 0 { dead_step(n - 1) } else { if false { dead_step(n + 1) } else { 0 } }
fn dead_steps() -> int = dead_step(10)
fn r0(a: int, b: int, c: int) -> int = if c > 0 { r3(b, a, c - 1) } else { a + b }
fn r1(a: int, b: int, c: int) -> int = if c > 0 { r4(b, a, c - 1) } else { a + b }
fn r2(a: int, b: int, c: int) -> int = if c > 0 { r5(b, a, c - 1) } else { a + b }
fn r3(a: int, b: int, c: int) -> int = if c > 0 { r1(b, a, c - 1) } else { a + b }
fn r4(a: int, b: int, c: int) -> int = if c > 0 { r2(b, a, c - 1) } else { a + b }
fn r5(a: int, b: int, c: int) -> int = if c > 0 { r0(b, a, c - 1) } else { a + b }
fn ring() -> int = r0(1, 2, 20)
