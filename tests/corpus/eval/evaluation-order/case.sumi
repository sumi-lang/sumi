fn pair(a: int, b: int) -> int = a * 10 + b
fn left_to_right() -> int = pair(pair(1, 2), pair(3, 4))
fn left_argument_traps_first() -> int = pair(1 / 0, 9223372036854775807 + 1)
fn left_operand_traps_first() -> int = (1 % 0) - (9223372036854775807 * 2)
fn right_trap_reached() -> int = pair(1, 9223372036854775807 + 1)
fn statements() -> int {
    let a = 1
    let b = a + 1
    let a = b * 10
    _ = a / 0 == 0 || true
    if a > b { a - b } else { b - a }
}
fn operands() -> int = 100 - 10 - 1 - 2 * 3 % 4
fn truthy() -> bool = (1 < 2) == true
