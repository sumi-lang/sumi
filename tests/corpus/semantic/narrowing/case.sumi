fn climb(n: int) -> int = if n > 100 { n } else { climb(n + 7) }
fn climbed() -> int = climb(0)
fn descend(n: int) -> int = if n < 3 { n } else { descend(n - 5) }
fn descended() -> int = descend(50)
fn lapped(n: int, m: int) -> int = if n < m { lapped(n + 1, m - 1) } else { n }
fn laps() -> int = lapped(0, 1000)
