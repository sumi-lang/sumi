== formatted ==
fn climb(n: int) -> int = if n > 100 {
    n
} else {
    climb(n + 7)
}
fn climbed() -> int = climb(0)
fn descend(n: int) -> int = if n < 3 {
    n
} else {
    descend(n - 5)
}
fn descended() -> int = descend(50)
fn lapped(n: int, m: int) -> int = if n < m {
    lapped(n + 1, m - 1)
} else {
    n
}
fn laps() -> int = lapped(0, 1000)
fn rise(n: int) -> int = if n > 5 {
    n
} else {
    rise(n + 2)
}
fn upto(n: int, k: int) -> int = if n > k {
    n
} else {
    upto(n + 1, k)
}
fn passed_through() -> int = upto(0, rise(0) + 3)
fn same(n: int) -> int = n
fn compared(a: int) -> int = if same(a * 3) == a {
    1
} else {
    0
}
fn compareds() -> int = compared(1) + compared(2)
fn climb_compared(a: int) -> int = if climb(a * 3) == a {
    1
} else {
    0
}
fn climbs_compared() -> int = climb_compared(1) + climb_compared(2)
fn relay(n: int) -> int {
    let a: int = n
    let b: int = a
    let c: int = b
    let d: int = c
    let e: int = d
    let f: int = e
    let g: int = f
    let h: int = g
    let i: int = h
    if i > 100 {
        i
    } else {
        relay(i + 7)
    }
}
fn relayed() -> int = relay(0)
