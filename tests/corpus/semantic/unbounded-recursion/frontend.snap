== formatted ==
fn forever(n: int) -> int = forever(n + 1)
fn too_deep() -> int = forever(0)
fn fall(n: int) -> int = if n > 100 {
    0
} else {
    fall(n - 1)
}
fn falls() -> int = fall(5)
fn swap(a: int, b: int) -> int = swap(b, a)
fn swapped() -> int = swap(1, 2)
fn spin() -> int = spin()
fn both(a: int, b: int) -> int = both(a + 1, b + 1)
fn boths() -> int = both(0, 0)
fn either(n: int) -> int = if n > 10 {
    0
} else {
    if n < 0 {
        0
    } else {
        either(n - 1) + either(n + 1)
    }
}
fn eithers() -> int = either(5)
fn ping(n: int) -> int = pong(n)
fn pong(n: int) -> int = ping(n)
fn pings() -> int = ping(3)
