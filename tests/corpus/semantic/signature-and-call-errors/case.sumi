fn duplicate() {}
fn ambiguous() = duplicate()
fn unknown(x: mystery) {}
fn suppressed() = unknown(absent)
fn typed(x: int, b: bool) -> int = x
fn twice(x: int, x: bool) -> int = x
fn wrong() -> int = typed(true, 1, missing)
