== formatted ==
fn at(xs: [int], i: int) -> int = xs[i]

fn half(a: int, b: int) -> int = a / b

fn first(xs: [int], n: int) -> int {
    let mut sum = 0
    for i in 0..n {
        sum += xs[i]
    }
    sum
}

fn through(xs: [int], i: int) -> int = at(xs, i + 1)

fn swap(mut a: int, mut b: int) {
    let t = a
    a = b
    b = t
}

fn swap_at(mut xs: [int], i: int, j: int) {
    swap(mut xs[i], mut xs[j])
}

type Row {
    cells: [int],
}

type Empty {}

fn cell(row: Row | Empty, i: int) -> int = match row {
    Row(r) => r.cells[i],
    Empty => 0,
}

fn rev(xs: [int], i: int) -> int = 100 / xs[xs.len() - 1 - i]

fn zero(d: int) -> int = if d == 0 {
    100 / d
} else {
    1
}

fn down(xs: [int], i: int) -> int = if i < 0 {
    0
} else {
    xs[i] + down(xs, i - 1)
}

type Grid {
    cells: [int],
}

fn cell_of(g: Grid, i: int) -> int = g.cells[i]

fn take(mut xs: [int]) -> int = xs.pop()

fn back(xs: [int], i: int) -> int = 100 / xs[0 - i]

fn third(xs: [int]) -> int = 100 / xs[2]

fn minus(b: int) -> int = 100 / (0 - b)

fn less(a: int, b: int) -> int = 100 / (a - b - 1)

fn more(a: int, b: int) -> int = 100 / (a - b + 2)

fn ping(xs: [int], i: int) -> int = if i <= 0 {
    0
} else {
    pong(xs, i - 1)
}

fn pong(xs: [int], i: int) -> int = xs[i] + ping(xs, i)

fn maybe() -> int {
    let mut sum = 0
    for k in 0..2 {
        let mut ys: [int] = []
        let mut zs: [int] = []
        if k > 0 {
            ys.push(k)
            zs.push(k)
        }
        sum += half(1, k) + take(mut ys) + zs.pop()
    }
    sum
}

fn kept() -> int {
    let mut xs = [1, 2, 3]
    swap_at(mut xs, 0, 2)
    let rows = cell(Row(cells: [1, 2]), 1) + cell(Row(cells: [3]), 0) + cell(Empty(), 7)
    rows + at(xs, 2) + half(8, 2) + half(9, -3) + first(xs, 3) + first([], -2) + through(xs, 1)
}

fn main() -> int {
    let mut xs = [1, 2, 3]
    swap_at(mut xs, 1, 1)
    for i in 0..xs.len() {
        swap(mut xs[i], mut xs[0])
    }
    let bad = at(xs, 3) + at(xs, 0 - 1) + half(1, 0) + first(xs, 4) + through(xs, 2)
    let worse = cell_of(Grid(cells: [1]), 1) + back([0], 0) + third([1, 2, 0]) + minus(0)
    let worst = less(1, 0) + more(0, 2) + ping(xs, 3) + ping([1], 1) + maybe()
    kept() + bad + zero(0) + down(xs, 3) + rev([0], 0) + worse + worst
}
