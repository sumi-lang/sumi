fn parameter(n: int, m: int) -> int = m
fn binding() -> int {
    let x = 1
    2
}
fn silenced(_n: int) -> int {
    let _x = 1
    3
}
fn loop_index() -> int {
    let mut total = 0
    for i in 0..3 {
        total = total + 1
    }
    total
}
fn assigned() -> int {
    let mut x = 1
    x = 2
    4
}
fn shadowed() -> int {
    let x = 1
    let x = 2
    x
}
fn dead_read(n: int) -> int = if false {
    n
} else {
    5
}
fn local_taken(x: int, _x: int) -> int = _x
fn _six() -> int = 6
fn function_taken(six: int) -> int = _six()
fn caller() -> int = parameter(1, 2) + dead_read(3) + local_taken(4, 5) + function_taken(6)
