fn stale(mut xs: [int], i: int) -> int {
    if 0 <= i && i < xs.len() {
        _ = xs.pop()
        return xs[i]
    }
    0
}

fn moved(xs: [int], i: int) -> int {
    let mut j = i
    if 0 <= j && j < xs.len() {
        j += 1
        return xs[j]
    }
    0
}

fn other(xs: [int], ys: [int], i: int) -> int {
