fn shrinking(mut xs: [int]) -> int {
    let mut sum = 0
    for i in 0..xs.len() {
        shrink(mut xs)
        sum += xs[i]
    }
    sum
}

fn replaced(mut xs: [int]) -> int {
    let mut sum = 0
    for i in 0..xs.len() {
        xs = [i]
        sum += xs[i]
    }
    sum
}

fn ragged(mut grid: [[int]]) {
    for y in 0..grid.len() {
        for x in 0..grid[y].len() {
            grid[y] = [x]
            grid[y][x] = 0
        }
    }
}

fn past(xs: [int]) -> int {
    let mut sum = 0
    for i in 0..xs.len() {
        sum += xs[i + 1]
    }
    for i in 0..xs.len() + 1 {
        sum += xs[i]
    }
    sum
}

fn wipe(mut rows: [[int]]) {
    for i in 0..rows.len() {
        rows[i] = []
    }
}

fn wiped(mut rows: [[int]]) -> int {
    if rows.len() == 0 {
        return 0
    }
    let n = rows[0].len()
    wipe(mut rows)
    let mut sum = 0
    for j in 0..n {
        sum += rows[0][j]
    }
    sum
}

