    if x < 5 {
        xs[x * -9223372036854775808]
    } else {
        0
    }
}

fn signed(xs: [int], k: int) -> int {
    if xs.len() > 0 {
        xs[k % xs.len()]
    } else {
        0
    }
}

fn main() -> int {
    let mut xs = [1, 2, 3]
    let mut grid = [[1, 2], [3]]
    ragged(mut grid)
    let a = stale(mut xs, 2) + moved(xs, 1) + other(xs, [1, 2, 3, 4], 3)
    let b = wiped(mut grid) + wide(xs, 1)
    a + b + shrinking(mut xs) + replaced(mut xs) + past(xs) + signed(xs, 0 - 1)
}
