fn total(xs: [int]) -> int {
    let mut sum = 0
    for i in 0..xs.len() {
        sum += xs[i]
    }
    sum
}

fn rising(xs: [int]) -> int {
    let mut count = 0
    for i in 0..xs.len() - 1 {
        if xs[i] < xs[i + 1] {
            count += 1
        }
    }
    count
}

fn guarded(xs: [int], i: int) -> int {
    if 0 <= i && i < xs.len() { xs[i] } else { 0 }
}

fn after(xs: [int], i: int) -> int {
    if i < 0 || i + 1 >= xs.len() {
        return 0
    }
    xs[i + 1]
}

fn wrapped(xs: [int], k: int) -> int {
    if xs.len() > 0 && k >= 0 { xs[k % xs.len()] } else { 0 }
}

fn last(xs: [int]) -> int {
    let mut ys = xs
    if ys.len() > 0 { ys.pop() } else { 0 }
}

fn head(xs: [int]) -> int {
    if xs.len() != 0 { xs[0] } else { 0 }
}

fn inverses(n: int) -> int {
    let mut sum = 0
    for k in 0..n {
        sum += 100 / (n - k)
    }
    sum
}

fn main() -> int {
    let a = total([1, 2]) + total([1, 2, 3]) + rising([1, 3, 2, 4]) + rising([])
    let b = guarded([1, 2], 1) + guarded([1, 2, 3], 7) + after([1, 2, 3], 1) + after([4], 0)
    let c = head([4, 5]) + head([])
    a + b + c + wrapped([1, 2, 3], 7) + wrapped([], 3) + last([5, 6]) + last([]) + inverses(4)
}
