fn value() = forward()
fn forward() = {
    1
}
fn explicit() -> int = value()
fn recursive() = if true {
    1
} else {
    recursive()
}
fn anchored() -> int = if false {
    inferred()
} else {
    1
}
fn inferred() = anchored()
fn integer() = {
    if false {
        _ = boolean()
    }
    1
}
fn boolean() = {
    _ = integer()
    true
}
fn empty() = {}
fn chained() = {
    let x = forward()
    let x = x + 1
    x
}
fn discards() {
    empty()
    _ = 1
}
