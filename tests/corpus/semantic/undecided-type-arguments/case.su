type Box<T> {
    value: T,
}
type Pair<A, B> {
    first: A,
    second: B,
}
type Tagged<T> {
    tag: int,
}
type None {}
fn id<T>(x: T) -> T = x
fn empty<T>() -> Box<T> | None = None()
fn first<A, B>(a: A) -> A = a
fn least<T>(a: T, b: T) -> T = a
fn unwrap_or<T>(v: Box<T> | None, fallback: T) -> T = match v {
    Box(b) => b.value,
    None => fallback,
}
fn open() -> int {
    let a = empty()
    let b = first(1)
    let c = Tagged(tag: 1)
    let d = Pair(first: 1)
    let e = unwrap_or(None(), 0)
    let f = id()
    e
}
fn disagreeing() -> int {
    let a = least(1, true)
    let b = unwrap_or(Box(value: true), 2)
    a
}
fn failed() -> int {
    let a = id(missing)
    let b = Box(value: missing)
    0
}
fn returning(n: int) -> int {
    let a = id(if { return n
        true } { 1 } else { 2 })
    let b = Box(value: { return 0 })
    a
}
fn arms(v: Box<int> | Box<bool> | None, w: Pair<int, int> | None, n: int) -> int {
    let a = match v {
        Box(b) => 1,
        None => 0,
    }
    let b = match w {
        Box(b) => 1,
        _ => 0,
    }
    let c = match n {
        Box(b) => 1,
    }
    a + b + c
}
fn either<U>(v: Box<U> | Box<int>) -> int = 0
fn held_as_it_stands() -> int = either(Box(value: 1))
fn conflicted(c: bool) = if c {
    1
} else {
    true
}
fn echoes() -> int = id(conflicted(true))
fn count(n: int) = if n <= 0 {
    0
} else {
    id(count(n - 1))
}
fn partly(n: int) = if n <= 0 {
    None()
} else {
    id(if n == 1 {
        Box(value: 0)
    } else {
        partly(n - 1)
    })
}
fn matched<T>(x: T, n: int) = if n <= 0 {
    Box(value: x)
} else {
    match matched(x, n - 1) {
        Box(b) => Box(value: b.value),
    }
}
fn recursions() -> int {
    _ = partly(2)
    _ = matched(true, 3)
    count(3)
}
fn grow<T>(x: T, n: int) -> int = if n == 0 {
    0
} else {
    grow(Box(value: x), n - 1)
}
fn ping<A, B>(a: A, b: B, n: int) -> int = if n == 0 {
    0
} else {
    pong<B, A>(b, a, n - 1)
}
fn pong<A, B>(a: A, b: B, n: int) -> int = ping(Pair(first: a, second: b), b, n)
fn main() -> int = grow(1, 3) + ping(1, true, 3)
