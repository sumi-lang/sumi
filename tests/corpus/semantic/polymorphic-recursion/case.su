type Box<T> {
    value: T,
}
type Pair<A, B> {
    first: A,
    second: B,
}
fn grow<T>(x: T, n: int) -> int = if n == 0 {
    0
} else {
    grow<Box<T>>(Box<T>(value: x), n - 1)
}
fn ping<A, B>(a: A, b: B, n: int) -> int = if n == 0 {
    0
} else {
    pong<B, A>(b, a, n - 1)
}
fn pong<A, B>(a: A, b: B, n: int) -> int = ping<Pair<A, B>, B>(Pair<A, B>(first: a, second: b), b, n)
fn steady<T>(x: T, n: int) -> int = if n == 0 {
    0
} else {
    steady<T>(x, n - 1) + fixed<Box<int>>(Box<int>(value: n), n - 1)
}
fn fixed<T>(x: T, n: int) -> int = if n == 0 {
    0
} else {
    steady<Box<int>>(Box<int>(value: n), n - 1)
}
fn main() -> int = grow<int>(1, 3) + ping<int, bool>(1, true, 3) + steady<int>(1, 3)
