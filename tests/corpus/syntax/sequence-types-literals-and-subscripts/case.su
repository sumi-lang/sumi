type Grid { cells: [[int]], names: Box<[int]> }

fn build( xs : [ int ] , grid: [[bool]]) -> [int] {
    let empty: [int] = [ ]
    let one = [1,]
    let many = [ 1 , 2,
      3 ]
    let nested = [[1, 2], [], [3]]
    xs[0] = many[ 1 ] + nested[0][1]
    grid[0][1] = true
    let value = f<[int]>(xs)[0].first[1 + 2]
    [xs[0], -xs[1], (xs)[2], xs.len()]
}

fn long(some_quite_long_sequence_name: [int]) -> [int] = [some_quite_long_sequence_name[0], some_quite_long_sequence_name[1], some_quite_long_sequence_name[2]]

