// One accepted program that uses every construct, kept as the golden
// parse tree of a file whose parse is not in question.
fn main() {
    let total = sum_to(10)
    let mut count = 0
    count = count + 1
    _ = report(total, count)
    if is_even(total) && !is_zero(count) || total < 0 {
        each(names(), greet(0))
    } else if total >= 100 {
        return
    } else {
        _ = greet(0)
    }
}

fn sum_to(n: int) -> int = if n == 0 {
    0
} else {
    n + sum_to(n - 1)
}

fn is_even(n: int) -> bool = n % 2 == 0

fn is_zero(n: int) -> bool = n == 0

fn report(total: int, count: int) -> int {
    let scaled = (total * 3 - 1) / count
    let squared = {
        let base = scaled
        base * base
    }
    -squared
}

fn greet(name: int) -> int = name

type Point {
    x: int,
    y: int,
}

fn shift(p: Point, dx: int) -> Point = Point(x: p.x + dx, y: p.y)

fn names() -> unit = {}

fn each(items: unit, visit: unit) {
    _ = items
    _ = visit
}

fn compose(f: int, g: int) -> int = f + g

fn adder(x: int) -> int = x

fn thunk() = work(1, 2)

fn work(a: int, b: int) -> bool = a != b && a <= b || a > b

fn empty() {}

fn unit_value() -> unit {
    return
}

type Box<T> {
    value: T,
}

fn wrap<T>(x: T) -> Box<T> = Box<T>(value: x)

fn unwrap(b: Box<int>) -> int = wrap<Box<int>>(b).value.value

fn bump(mut p: Point, by: int) {
    p.x = p.x + by
}

fn moved() -> int {
    let mut p = Point(x: 1, y: 2)
    bump(mut p, 3)
    p.x += 1
    p.x -= 2
    p.x *= 3
    p.x /= 4
    p.x %= 5
    p.x
}

impl Point {
    fn sum(self) = self.x + self.y

    fn shift(mut self, dx: int) {
        self.x += dx
    }
}

impl Box<T> {
    fn with<U>(self, other: U) -> Box<U> = Box(value: other)
}

fn methods() -> int {
    let mut p = Point(x: 1, y: 2)
    p.shift(3)
    Box(value: p).with<Point>(p).value.sum()
}
