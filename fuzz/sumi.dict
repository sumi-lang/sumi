# Every fixed token text, in step with tokens! in crates/lexer/src/kind.rs, and every operator the
# parser glues, plus a comment start.
Underscore="_"
ElseKw="else"
FalseKw="false"
FnKw="fn"
ForKw="for"
IfKw="if"
ImplKw="impl"
InKw="in"
LetKw="let"
MatchKw="match"
MutKw="mut"
ReturnKw="return"
SelfKw="self"
TrueKw="true"
TypeKw="type"
LParen="("
RParen=")"
LBrace="{"
RBrace="}"
Comma=","
Colon=":"
Dot="."
Eq="="
Lt="<"
Gt=">"
Bang="!"
Plus="+"
Minus="-"
Star="*"
Slash="/"
Percent="%"
Amp="&"
Pipe="|"
"->"
"=>"
".."
"=="
"+="
"-="
"*="
"/="
"%="
"!="
"<="
">="
"&&"
"||"
"//"
