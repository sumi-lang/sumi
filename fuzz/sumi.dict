# Every fixed token text, in step with tokens! in crates/lexer/src/kind.rs, and every operator the
# parser glues, plus a comment start and an escaped string delimiter.
Underscore="_"
ElseKw="else"
FalseKw="false"
FnKw="fn"
IfKw="if"
LetKw="let"
MutKw="mut"
ReturnKw="return"
TrueKw="true"
LParen="("
RParen=")"
LBrace="{"
RBrace="}"
Comma=","
Colon=":"
Dot="."
Eq="="
Lt="<"
Gt=">"
Bang="!"
Plus="+"
Minus="-"
Star="*"
Slash="/"
Percent="%"
Amp="&"
Pipe="|"
"->"
"=="
"!="
"<="
">="
"&&"
"||"
"//"
"\"\\"
