# Every fixed token text and compound operator, so byte-level mutation can
# splice in whole tokens, and the lexer's texts: a comment's start, and a
# string's delimiter with an escape.
Underscore="_"
ElseKw="else"
FalseKw="false"
FnKw="fn"
IfKw="if"
LetKw="let"
MutKw="mut"
ReturnKw="return"
TrueKw="true"
LParen="("
RParen=")"
LBrace="{"
RBrace="}"
Comma=","
Colon=":"
Dot="."
Eq="="
Lt="<"
Gt=">"
Bang="!"
Plus="+"
Minus="-"
Star="*"
Slash="/"
Percent="%"
Amp="&"
Pipe="|"
"->"
"=="
"!="
"<="
">="
"&&"
"||"
"//"
"\"\\"
